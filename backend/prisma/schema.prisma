// Prisma schema for Tour Booking — PostgreSQL (TourBookingDB, schema public)
// NOTE (theo ảnh chốt):
// 1. User.email đã @unique -> PostgreSQL/Prisma tự tạo unique index, KHÔNG thêm @@index([email]) thừa.
// 2. Payment khi tạo booking luôn PENDING cho cả CASH/BANK_TRANSFER/CARD (chưa có gateway).
// 3. Tạo booking phải dùng Prisma $transaction (Booking + BookingGuest + Payment + giảm seats + tăng coupon.usedCount).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TourCategory {
  Beach
  Mountains
  Culture
  Relaxation
}

enum TourStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  avatar       String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
  reviewVotes ReviewVote[]
}

model Tour {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  description    String       @db.Text
  category       TourCategory
  destination    String
  departureLocation String    @default("")
  transportation String[]     @default([])
  includedServices String[]   @default([])
  excludedServices String[]   @default([])
  images         String[]
  duration       String
  price          Int
  // Child ticket: null = no child pricing (everyone pays adult price).
  childPrice     Int?
  childMaxAge    Int?
  // Per-tour add-ons snapshot schema: [{id, name, price, perPerson}].
  addons         Json           @default("[]")
  // Free cancellation window in hours before travelDate. Null = flexible
  // (customer may cancel any time before the travel day, legacy behavior).
  freeCancelHours Int?
  itinerary      Json           @default("[]")
  minGuests      Int          @default(1)
  maxGuests      Int          @default(20)
  availableSeats Int          @default(30)
  rating         Float        @default(0)
  reviewCount    Int          @default(0)
  featured       Boolean      @default(false)
  status         TourStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
  dates     TourDate[]

  @@index([destination])
  @@index([departureLocation])
  @@index([category])
  @@index([status])
  @@index([featured])
}

// Optional per-day inventory. A date WITHOUT a row is open (only the tour's
// global availableSeats applies). A date WITH a row caps bookings at capacity.
model TourDate {
  id        String   @id @default(cuid())
  tourId    String
  date      DateTime @db.Date
  capacity  Int
  booked    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, date])
  @@index([tourId])
}

model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType
  value      Int
  minOrder   Int        @default(0)
  expiresAt  DateTime
  usageLimit Int?
  usedCount  Int        @default(0)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  bookingCode   String        @unique
  userId        String
  tourId        String
  couponId      String?
  travelDate    DateTime
  guests        Int
  // Null on legacy rows = all adults (adults ?? guests, children ?? 0).
  adults        Int?
  children      Int?
  // Add-on snapshot at booking time: [{id, name, price, perPerson}].
  addons        Json           @default("[]")
  addonsTotal   Int            @default(0)
  customerName  String
  customerEmail String
  customerPhone String
  note          String?
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  bookingStatus BookingStatus @default(PENDING)
  reminderSentAt    DateTime?
  reviewInviteSentAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour   Tour    @relation(fields: [tourId], references: [id], onDelete: Restrict)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  guestsList BookingGuest[]
  payment    Payment?
  reviews    Review[]

  @@index([userId])
  @@index([tourId])
  @@index([bookingStatus])
  @@index([travelDate])
}

model BookingGuest {
  id          String    @id @default(cuid())
  bookingId   String
  fullName    String
  dateOfBirth DateTime?
  gender      Gender?
  isChild     Boolean   @default(false)
  phone       String?
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  amount          Int
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionCode String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  tourId    String
  bookingId String   @unique
  rating    Int
  comment   String?  @db.Text
  images    String[] @default([])
  helpfulCount Int   @default(0)
  hidden    Boolean  @default(false)
  adminReply String? @db.Text
  adminRepliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour    Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  votes   ReviewVote[]

  @@index([tourId])
  @@index([userId])
}

// One helpful-vote per user per review (toggle semantics).
model ReviewVote {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  tourId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@index([userId])
  @@index([tourId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
