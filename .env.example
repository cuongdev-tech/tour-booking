# ---- Frontend (Vite) ----
# Base URL of the backend REST API consumed via src/services/api.ts
VITE_API_URL="http://localhost:5000/api"

# ---- Backend (backend/.env, local only, never commit) ----
# PostgreSQL connection for TourBookingDB (managed via pgAdmin 4)
DATABASE_URL="postgresql://user:password@localhost:5432/TourBookingDB?schema=public"
# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
# e.g. 7d, 24h
JWT_EXPIRES_IN="7d"
# Backend port
PORT=5000
# Frontend origin allowed by CORS
FRONTEND_URL="http://localhost:3000"
# ---- Demo bank account shown on the payment QR (VietQR, not a secret) ----
# e.g. MB / VCB / BIDV...; defaults are demo values when left empty
BANK_NAME="MB"
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_NAME="TOUR BOOKING DEMO"
# ---- Transactional email (optional; password reset is disabled without these) ----
# e.g. smtp.gmail.com with an app password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tour Booking <no-reply@example.com>"
